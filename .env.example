# Backend
RUNOVA_ENVIRONMENT=development
RUNOVA_DEBUG=true
RUNOVA_DATABASE_URL=postgresql+asyncpg://runova:runova@localhost:5432/runova
RUNOVA_REDIS_URL=redis://localhost:6379/0
RUNOVA_CORS_ORIGINS=["http://localhost:3000"]
RUNOVA_DEV_LOGIN_ENABLED=true
RUNOVA_RATE_LIMIT_ENABLED=true
RUNOVA_RATE_LIMIT_AUTH_PER_MINUTE=10
RUNOVA_RATE_LIMIT_API_PER_MINUTE=240
RUNOVA_DEV_JWT_SECRET=replace-with-a-long-random-local-secret
RUNOVA_DEV_TOKEN_MINUTES=10080
RUNOVA_ROAD_MATCH_BASE_URL=
RUNOVA_ROAD_MATCH_PROFILE=foot

# Supabase Auth (add real values locally; never commit secrets)
RUNOVA_SUPABASE_URL=
RUNOVA_SUPABASE_JWT_ISSUER=
RUNOVA_SUPABASE_JWT_AUDIENCE=authenticated

# Mobile build-time configuration
RUNOVA_API_BASE_URL=http://10.0.2.2:8000
RUNOVA_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
RUNOVA_SUPABASE_PUBLISHABLE_KEY=
